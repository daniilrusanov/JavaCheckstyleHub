# Server Configuration
server.port=8000

# Database Configuration (MySQL)
spring.datasource.url=jdbc:mysql://localhost:3306/checkstyle_hub?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true&autoReconnect=true
spring.datasource.username=root
spring.datasource.password=YOUR_PASSWORD_HERE
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

# JPA/Hibernate Configuration
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=false
spring.jpa.properties.hibernate.connection.autocommit=true

# Connection Pool Configuration
spring.datasource.hikari.auto-commit=true

# Redis (cache for analysis results by repo URL + commit hash)
spring.data.redis.host=localhost
spring.data.redis.port=6379
# In Docker Compose, set SPRING_DATA_REDIS_HOST=redis (service name)
spring.data.redis.repositories.enabled=false

# Docker Compose
spring.docker.compose.enabled=false

# JWT Configuration
jwt.secret=YOUR_JWT_SECRET_KEY_MUST_BE_AT_LEAST_256_BITS_LONG
jwt.expiration=86400000

# Default Admin User
admin.username=admin
admin.email=admin@checkstylehub.com
admin.password=admin123

# Alternative: H2 In-Memory Database (for development/testing)
# Uncomment the lines below and comment out MySQL configuration above
# spring.datasource.url=jdbc:h2:mem:checkstyle_hub;DB_CLOSE_DELAY=-1;DB_CLOSE_ON_EXIT=FALSE
# spring.datasource.username=sa
# spring.datasource.password=
# spring.datasource.driver-class-name=org.h2.Driver
# spring.h2.console.enabled=true
# spring.h2.console.path=/h2-console
# spring.h2.console.settings.web-allow-others=true

